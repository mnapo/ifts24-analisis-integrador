table Calendario
    column Fecha
        dataType: dateTime
        formatString: Short Date
        isKey
        summarizeBy: none
        sourceColumn: Fecha

    column Año
        dataType: int64
        formatString: 0
        summarizeBy: none
        sourceColumn: Año

    column 'Mes Número'
        dataType: int64
        formatString: 0
        summarizeBy: none
        sourceColumn: Mes Número

    column Mes
        dataType: string
        sortByColumn: 'Mes Número'
        summarizeBy: none
        sourceColumn: Mes

    column AñoMes
        dataType: string
        summarizeBy: none
        sourceColumn: AñoMes

    partition Calendario = m
        mode: import
        source =
            let
                StartDate = #date(2025, 1, 1),
                EndDate = #date(2025, 12, 31),
                DateList = List.Dates(
                    StartDate,
                    Duration.Days(EndDate - StartDate) + 1,
                    #duration(1, 0, 0, 0)
                ),
                DateTable = Table.FromList(DateList, Splitter.SplitByNothing(), {"Fecha"}),
                ChangedType = Table.TransformColumnTypes(DateTable, {{"Fecha", type date}}),
                AddedYear = Table.AddColumn(ChangedType, "Año", each Date.Year([Fecha]), Int64.Type),
                AddedMonthNumber = Table.AddColumn(AddedYear, "Mes Número", each Date.Month([Fecha]), Int64.Type),
                AddedMonth = Table.AddColumn(AddedMonthNumber, "Mes", each Date.MonthName([Fecha], "es-AR"), type text),
                AddedYearMonth = Table.AddColumn(AddedMonth, "AñoMes", each Date.ToText([Fecha], "yyyy-MM"), type text)
            in
                AddedYearMonth
