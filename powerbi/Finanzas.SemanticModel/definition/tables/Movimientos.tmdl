table Movimientos
    /// Suma de todas las operaciones clasificadas como ingresos.
    measure 'Total Ingresos' =
        CALCULATE(
            SUM(Movimientos[importe]),
            Movimientos[tipo] = "Ingreso"
        )
        formatString: $ #,##0;-$ #,##0

    /// Suma de todas las operaciones clasificadas como gastos.
    measure 'Total Gastos' =
        CALCULATE(
            SUM(Movimientos[importe]),
            Movimientos[tipo] = "Gasto"
        )
        formatString: $ #,##0;-$ #,##0

    /// Diferencia entre ingresos y gastos.
    measure 'Balance Neto' = [Total Ingresos] - [Total Gastos]
        formatString: $ #,##0;-$ #,##0

    /// Cantidad de operaciones dentro del contexto de filtros actual.
    measure 'Cantidad de Movimientos' = COUNTROWS(Movimientos)
        formatString: #,##0

    /// Importe promedio de todas las operaciones del contexto actual.
    measure 'Promedio por Movimiento' = AVERAGE(Movimientos[importe])
        formatString: $ #,##0.00;-$ #,##0.00

    /// Total de operaciones de ingreso.
    measure 'Cantidad de Ingresos' =
        CALCULATE(
            COUNTROWS(Movimientos),
            Movimientos[tipo] = "Ingreso"
        )
        formatString: #,##0

    /// Total de operaciones de gasto.
    measure 'Cantidad de Gastos' =
        CALCULATE(
            COUNTROWS(Movimientos),
            Movimientos[tipo] = "Gasto"
        )
        formatString: #,##0

    column id
        dataType: int64
        isKey
        summarizeBy: none
        sourceColumn: id

    column fecha
        dataType: dateTime
        formatString: Short Date
        summarizeBy: none
        sourceColumn: fecha

    column tipo
        dataType: string
        summarizeBy: none
        sourceColumn: tipo

    column categoria
        dataType: string
        summarizeBy: none
        sourceColumn: categoria

    column descripcion
        dataType: string
        summarizeBy: none
        sourceColumn: descripcion

    column importe
        dataType: decimal
        formatString: $ #,##0.00;-$ #,##0.00
        summarizeBy: sum
        sourceColumn: importe

    column medio_pago
        dataType: string
        summarizeBy: none
        sourceColumn: medio_pago

    partition Movimientos = m
        mode: import
        source =
            let
                Source = Csv.Document(
                    Web.Contents("https://raw.githubusercontent.com/mnapo/ifts24-analisis-integrador/main/public/data/movimientos.csv"),
                    [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                ),
                PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
                ChangedTypes = Table.TransformColumnTypes(
                    PromotedHeaders,
                    {
                        {"id", Int64.Type},
                        {"fecha", type date},
                        {"tipo", type text},
                        {"categoria", type text},
                        {"descripcion", type text},
                        {"importe", Currency.Type},
                        {"medio_pago", type text}
                    },
                    "es-AR"
                )
            in
                ChangedTypes
