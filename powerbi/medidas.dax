-- Modelo: IndicadoresLatam. No combinar escalas de indicadores distintos.
Valor del Indicador =
IF(
    HASONEVALUE(Indicadores[CodigoIndicador]),
    AVERAGE(FactIndicadores[Valor]),
    BLANK()
)

Promedio Regional =
IF(
    HASONEVALUE(Indicadores[CodigoIndicador]),
    AVERAGEX(ALL(Paises), CALCULATE([Valor del Indicador])),
    BLANK()
)

Brecha vs. Promedio =
IF(
    HASONEVALUE(Paises[CodigoPais]) && HASONEVALUE(Indicadores[CodigoIndicador]),
    [Valor del Indicador] - [Promedio Regional],
    BLANK()
)

Ranking País =
IF(
    HASONEVALUE(Paises[CodigoPais]) && HASONEVALUE(Indicadores[CodigoIndicador]),
    RANKX(ALL(Paises), CALCULATE([Valor del Indicador]), , DESC, DENSE),
    BLANK()
)

Países Analizados = DISTINCTCOUNT(FactIndicadores[CodigoPais])

Indicadores Analizados = DISTINCTCOUNT(FactIndicadores[CodigoIndicador])

País Líder =
IF(
    HASONEVALUE(Indicadores[CodigoIndicador]),
    VAR T = ADDCOLUMNS(ALL(Paises), "@Valor", CALCULATE([Valor del Indicador]))
    VAR L = TOPN(1, FILTER(T, NOT ISBLANK([@Valor])), [@Valor], DESC, Paises[CodigoPais], ASC)
    RETURN CONCATENATEX(L, Paises[País], ", "),
    BLANK()
)

Valor del Líder =
IF(
    HASONEVALUE(Indicadores[CodigoIndicador]),
    MAXX(ALL(Paises), CALCULATE([Valor del Indicador])),
    BLANK()
)
