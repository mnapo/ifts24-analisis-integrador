relationship Pais_FactIndicadores
    fromColumn: FactIndicadores.CodigoPais
    toColumn: Paises.CodigoPais
    fromCardinality: many
    toCardinality: one
    crossFilteringBehavior: oneDirection

relationship Indicador_FactIndicadores
    fromColumn: FactIndicadores.CodigoIndicador
    toColumn: Indicadores.CodigoIndicador
    fromCardinality: many
    toCardinality: one
    crossFilteringBehavior: oneDirection
