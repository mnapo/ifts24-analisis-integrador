table Indicadores
    column CodigoIndicador
        dataType: string
        isKey
        summarizeBy: none
        sourceColumn: indicator_code

    column NombreIndicador
        dataType: string
        summarizeBy: none
        sourceColumn: indicator_name

    column Unidad
        dataType: string
        summarizeBy: none
        sourceColumn: unit

    partition Indicadores = m
        mode: import
        source =
            let
                Source = Csv.Document(
                    Web.Contents("https://raw.githubusercontent.com/mnapo/ifts24-analisis-integrador/main/public/data/indicadores-banco-mundial.csv"),
                    [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                ),
                Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
                Selected = Table.SelectColumns(Headers, {"indicator_code", "indicator_name", "unit"}),
                CleanText = Table.TransformColumns(
                    Selected,
                    {
                        {"indicator_code", each if _ = null then null else Text.Trim(_), type text},
                        {"indicator_name", each if _ = null then null else Text.Trim(_), type text},
                        {"unit", each if _ = null then null else Text.Trim(_), type text}
                    }
                ),
                DistinctRows = Table.Distinct(CleanText),
                SortedRows = Table.Sort(DistinctRows, {{"indicator_code", Order.Ascending}})
            in
                SortedRows
